{
  "name": "kobato",
  "version": "8.0.3-dev",
  "private": true,
  "description": "A self-hosted blog CMS built with React Router 8, Hono, and oRPC",
  "keywords": [
    "blog",
    "cms",
    "kobato",
    "こばと"
  ],
  "homepage": "https://github.com/syhily/kobato",
  "bugs": {
    "url": "https://github.com/syhily/kobato/issues",
    "email": "syhily@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Yufan Sheng",
    "email": "syhily@gmail.com",
    "url": "https://github.com/syhily"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syhily/kobato"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "cd ../.. && ./apps/kobato/node_modules/.bin/react-router dev apps/kobato",
    "start": "cd ../.. && node ./apps/kobato/build/server/index.js",
    "typegen": "react-router typegen"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@kobato/inkling": "workspace:*",
    "@kobato/server": "workspace:*",
    "@kobato/shared": "workspace:*",
    "@kobato/test-helpers": "workspace:*",
    "@kobato/web": "workspace:*",
    "@napi-rs/canvas": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@orpc/server": "catalog:",
    "@playwright/test": "catalog:",
    "@react-router/dev": "catalog:",
    "@react-router/node": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bcryptjs": "catalog:",
    "drizzle-orm": "catalog:",
    "happy-dom": "catalog:",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.9.0"
  }
}
