{
  "name": "kobato",
  "version": "8.2.2-dev",
  "private": true,
  "description": "A self-hosted blog CMS built with React Router 8, Hono, and oRPC",
  "keywords": [
    "blog",
    "cms",
    "kobato",
    "こばと"
  ],
  "homepage": "https://github.com/syhily/kobato",
  "bugs": {
    "url": "https://github.com/syhily/kobato/issues",
    "email": "syhily@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Yufan Sheng",
    "email": "syhily@gmail.com",
    "url": "https://github.com/syhily"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syhily/kobato"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.backend.config.ts",
    "dev": "cd ../.. && vite apps/kobato",
    "start": "cd ../.. && node ./apps/kobato/build/server/index.js"
  },
  "devDependencies": {
    "@kobato/api": "workspace:*",
    "@kobato/base": "workspace:*",
    "@kobato/db": "workspace:*",
    "@kobato/i18n": "workspace:*",
    "@kobato/inkling": "workspace:*",
    "@kobato/pack": "workspace:*",
    "@kobato/server": "workspace:*",
    "@kobato/settings": "workspace:*",
    "@kobato/test": "workspace:*",
    "@kobato/tsconfig": "workspace:*",
    "@kobato/ui": "workspace:*",
    "@kobato/web-admin": "workspace:*",
    "@orpc/server": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "@types/node": "catalog:",
    "bcryptjs": "catalog:",
    "drizzle-orm": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.9.0"
  }
}
