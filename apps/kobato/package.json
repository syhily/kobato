{
  "name": "kobato",
  "version": "8.2.2-dev",
  "private": true,
  "description": "A self-hosted blog CMS built with React Router 8, Hono, and oRPC",
  "keywords": [
    "blog",
    "cms",
    "kobato",
    "こばと"
  ],
  "homepage": "https://github.com/syhily/kobato",
  "bugs": {
    "url": "https://github.com/syhily/kobato/issues",
    "email": "syhily@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Yufan Sheng",
    "email": "syhily@gmail.com",
    "url": "https://github.com/syhily"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syhily/kobato"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build && vite build --config vite.backend.config.ts",
    "dev": "cd ../.. && vite apps/kobato --config apps/kobato/vite.backend.config.ts",
    "dev:admin": "cd ../.. && react-router dev apps/kobato",
    "start": "cd ../.. && node ./apps/kobato/build/server/index.js",
    "typegen": "cd ../.. && react-router typegen apps/kobato"
  },
  "devDependencies": {
    "@dnd-kit/core": "catalog:",
