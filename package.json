{
  "name": "kobato-workspace",
  "version": "7.0.0-dev",
  "private": true,
  "description": "A self-hosted blog CMS built with React Router 8, Hono, and oRPC",
  "keywords": [
    "blog",
    "cms",
    "kobato",
    "こばと"
  ],
  "homepage": "https://github.com/syhily/kobato",
  "bugs": {
    "url": "https://github.com/syhily/kobato/issues",
    "email": "syhily@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Yufan Sheng",
    "email": "syhily@gmail.com",
    "url": "https://github.com/syhily"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syhily/kobato"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --parallel build",
    "bump": "taze && pnpm update",
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "pnpm -r --parallel dev",
    "emails:generate": "vite-node --config scripts/vite.node.config.ts scripts/generate-emails.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "prepare": "pnpx husky",
    "release:bump": "node --experimental-strip-types scripts/release.ts bump",
    "release:prepare-next": "node --experimental-strip-types scripts/release.ts prepare-next",
    "release:tag": "node --experimental-strip-types scripts/release.ts tag",
    "sea:build": "node scripts/sea/build.ts",
    "sea:e2e": "node scripts/sea/e2e.ts",
    "sea:smoke": "node scripts/sea/smoke.ts",
    "start": "pnpm -C apps/core start",
    "test": "vitest run",
    "test:it": "vitest run --project it*",
    "test:snaps": "vitest run --project snaps*",
    "test:unit": "vitest run --project unit*",
    "type": "pnpm -C apps/core exec react-router typegen && pnpm -C apps/public exec react-router typegen && tsc && tsc -p apps/core/tsconfig.json && tsc -p apps/public/tsconfig.json",
    "zeabur:login": "pnpx zeabur@latest auth login",
    "zeabur:publish": "pnpx zeabur@latest template update -c TK7XLK -f zeabur-template.yml"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@base-ui/react": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@date-fns/tz": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/vite-dev-server": "catalog:",
    "@lexical/code": "catalog:",
    "@lexical/headless": "catalog:",
    "@lexical/html": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/list": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/selection": "catalog:",
    "@lexical/table": "catalog:",
    "@lexical/utils": "catalog:",
    "@maxmind/geoip2-node": "catalog:",
    "@number-flow/react": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/react-query": "catalog:",
    "@orpc/server": "catalog:",
    "@react-router/dev": "catalog:",
    "@react-router/node": "catalog:",
    "@shikijs/transformers": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@smithy/types": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/diff-match-patch": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sanitize-html": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bcryptjs": "catalog:",
    "date-fns": "catalog:",
    "diff-match-patch": "catalog:",
    "dompurify": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "fake-indexeddb": "catalog:",
    "feed": "catalog:",
    "happy-dom": "catalog:",
    "hono": "catalog:",
    "hono-pino": "catalog:",
    "husky": "catalog:",
    "idb": "catalog:",
    "jsdom": "catalog:",
    "katex": "catalog:",
    "lexical": "catalog:",
    "lint-staged": "catalog:",
    "lucide-react": "catalog:",
    "lunar-typescript": "catalog:",
    "medium-zoom": "catalog:",
    "motion": "catalog:",
    "nodemailer": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino": "catalog:",
    "pinyin-pro": "catalog:",
    "qrcode.react": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "sanitize-html": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "ua-parser-js": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt -c oxfmt.config.ts --write",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.18.0"
}
