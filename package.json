{
  "name": "kobato",
  "version": "7.1.0-dev",
  "private": true,
  "description": "A self-hosted blog CMS built with React Router 8, Hono, and oRPC",
  "keywords": [
    "blog",
    "cms",
    "kobato",
    "こばと"
  ],
  "homepage": "https://github.com/syhily/kobato",
  "bugs": {
    "url": "https://github.com/syhily/kobato/issues",
    "email": "syhily@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Yufan Sheng",
    "email": "syhily@gmail.com",
    "url": "https://github.com/syhily"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syhily/kobato"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "bump": "taze && pnpm update",
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "react-router dev",
    "emails:generate": "vite-node scripts/generate-emails.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "prebuild": "node scripts/ensure-inkling-dist.ts",
    "predev": "node scripts/ensure-inkling-dist.ts",
    "prepare": "pnpx husky",
    "pretest": "node scripts/ensure-inkling-dist.ts",
    "pretype": "node scripts/ensure-inkling-dist.ts",
    "release:bump": "node scripts/release.ts bump",
    "release:prepare-next": "node scripts/release.ts prepare-next",
    "release:tag": "node scripts/release.ts tag",
    "sea:build": "node scripts/sea/build.ts",
    "sea:e2e": "node scripts/sea/e2e.ts",
    "sea:smoke": "node scripts/sea/smoke.ts",
    "start": "node ./build/server/index.js",
    "test": "vitest run",
    "test:it": "vitest run --project it",
    "test:snaps": "vitest run --project snaps",
    "test:unit": "vitest run --project unit",
    "type": "react-router typegen && tsc",
    "zeabur:login": "pnpx zeabur@latest auth login",
    "zeabur:publish": "pnpx zeabur@latest template update -c TK7XLK -f zeabur-template.yml"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@base-ui/react": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@date-fns/tz": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/vite-dev-server": "catalog:",
    "@inkling/editor": "workspace:*",
    "@maxmind/geoip2-node": "catalog:",
    "@number-flow/react": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/react-query": "catalog:",
    "@orpc/server": "catalog:",
    "@react-router/dev": "catalog:",
    "@react-router/node": "catalog:",
    "@shikijs/transformers": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@smithy/types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/diff-match-patch": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bcryptjs": "catalog:",
    "cn": "catalog:",
    "date-fns": "catalog:",
    "diff-match-patch": "catalog:",
    "dompurify": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "fake-indexeddb": "catalog:",
    "feed": "catalog:",
    "happy-dom": "catalog:",
    "hono": "catalog:",
    "hono-pino": "catalog:",
    "husky": "catalog:",
    "idb": "catalog:",
    "jsdom": "catalog:",
    "katex": "catalog:",
    "lint-staged": "catalog:",
    "lucide-react": "catalog:",
    "lunar-typescript": "catalog:",
    "medium-zoom": "catalog:",
    "motion": "catalog:",
    "nodemailer": "catalog:",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino": "catalog:",
    "pinyin-pro": "catalog:",
    "qrcode.react": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "ua-parser-js": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "{src,tests,scripts}/**/*.{ts,tsx}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ],
    "packages/inkling/{src,test,scripts,demo}/**/*.{ts,tsx}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ],
    "{drizzle.config.ts,oxfmt.config.ts,oxlint.config.ts,react-router.config.ts,taze.config.ts,vite.config.ts,vite.sea.config.ts,vitest.config.ts}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.4.1"
}
