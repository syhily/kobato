{
  "name": "kobato-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -C apps/kobato build",
    "bump": "taze && pnpm update",
    "db:gen": "pnpm -C packages/db db:gen && pnpm -C packages/db db:gen:duckdb",
    "demo": "vite apps/inkling-demo",
    "demo:content": "pnpm -C apps/inkling-demo generate:content",
    "dev": "pnpm -C apps/kobato dev",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "prepare": "pnpx husky",
    "release:bump": "pnpm -C tools/pack release:bump",
    "release:prepare-next": "pnpm -C tools/pack release:prepare-next",
    "release:tag": "pnpm -C tools/pack release:tag",
    "sea:browser": "pnpm -C tools/pack sea:browser",
    "sea:build": "pnpm -C tools/pack sea:build",
    "sea:e2e": "pnpm -C tools/pack sea:e2e",
    "sea:package": "pnpm -C tools/pack sea:package",
    "sea:probe": "pnpm -C tools/pack sea:probe",
    "sea:smoke": "pnpm -C tools/pack sea:smoke",
    "start": "pnpm -C apps/kobato start",
    "test": "vitest run",
    "test:browser": "pnpm -C tools/pack test:browser",
    "test:duckdb": "vitest run duckdb.test",
    "test:inkling": "vitest run packages/inkling/tests",
    "test:it": "vitest run tests/it",
    "test:production-rum": "vitest run apps/kobato/tests/arch/production-rum-bundle.test.ts",
    "test:snaps": "vitest run tests/snaps",
    "test:unit": "vitest run tests/unit apps/kobato/tests/arch",
    "trace:down": "pnpm -C tools/trace trace:down",
    "trace:init": "pnpm -C tools/trace trace:init",
    "trace:smoke": "pnpm -C tools/trace trace:smoke",
    "trace:status": "pnpm -C tools/trace trace:status",
    "trace:up": "pnpm -C tools/trace trace:up",
    "type": "pnpm -C apps/kobato typegen && tsc && pnpm -C apps/inkling-demo type",
    "version:sync": "pnpm -C tools/pack version:sync"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "@kobato/font-split": "workspace:*",
    "@napi-rs/canvas": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@kobato/pack": "workspace:*",
    "@kobato/test": "workspace:*",
    "@kobato/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ],
    "*.{md,json}": [
      "oxfmt -c oxfmt.config.ts --write"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.23.0"
}
