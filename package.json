{
  "name": "kobato-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -C apps/kobato build",
    "bump": "taze && pnpm update",
    "db:gen": "pnpm -C packages/db db:gen",
    "db:migrate": "pnpm -C packages/db db:migrate",
    "demo": "vite apps/inkling-demo",
    "dev": "pnpm -C apps/kobato dev",
    "emails:generate": "vite-node tools/email/src/generate.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "i18n:regional-diff": "vite-node tools/i18n/src/regional-diff.ts",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "prepare": "pnpx husky",
    "release:bump": "node tools/pack/src/release.ts bump",
    "release:prepare-next": "node tools/pack/src/release.ts prepare-next",
    "release:tag": "node tools/pack/src/release.ts tag",
    "sea:browser": "pnpm --filter @kobato/browser run sea:browser",
    "sea:build": "node tools/pack/src/sea/build.ts",
    "sea:e2e": "node tools/pack/src/sea/e2e.ts",
    "sea:probe": "node tools/pack/src/sea/vfs-capabilities.ts",
    "sea:smoke": "node tools/pack/src/sea/smoke.ts",
    "start": "pnpm -C apps/kobato start",
    "test": "vitest run",
    "test:browser": "pnpm --filter @kobato/browser run test:browser",
    "test:duckdb": "vitest run --project duckdb",
    "test:inkling": "vitest run --project inkling",
    "test:it": "vitest run --project '*-it'",
    "test:snaps": "vitest run --project '*-snaps'",
    "test:unit": "vitest run --project '*-unit'",
    "trace:down": "node tools/trace/src/down.ts",
    "trace:init": "node tools/trace/src/init.ts",
    "trace:smoke": "vite-node tools/trace/src/smoke.ts",
    "trace:status": "node tools/trace/src/status.ts",
    "trace:up": "node tools/trace/src/up.ts",
    "type": "pnpm -C apps/kobato typegen && tsc",
    "version:sync": "node tools/pack/src/release.ts sync-versions"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@kobato/pack": "workspace:*",
    "@kobato/toolchain": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "{apps,packages,tools,scripts}/**/*.{ts,tsx}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "packageManager": "pnpm@12.22.0"
}
