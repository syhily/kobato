    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@tiptap/suggestion": "^3.24.0",
    "aplayer-ts": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.7",
    "drizzle-orm": "~1.0.0-rc.3",
    "feed": "^5.2.1",
    "hono": "^4.12.23",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.11.0",
