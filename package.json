{
  "name": "kobato",
  "version": "7.1.0-dev",
  "private": true,
  "description": "A self-hosted blog CMS built with React Router 8, Hono, and oRPC",
  "keywords": [
    "blog",
    "cms",
    "kobato",
    "こばと"
  ],
  "homepage": "https://github.com/syhily/kobato",
  "bugs": {
    "url": "https://github.com/syhily/kobato/issues",
    "email": "syhily@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Yufan Sheng",
    "email": "syhily@gmail.com",
    "url": "https://github.com/syhily"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syhily/kobato"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "bump": "taze && pnpm update",
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "react-router dev",
    "emails:generate": "vite-node scripts/generate-emails.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "prebuild": "node scripts/ensure-inkling-dist.ts",
    "predev": "node scripts/ensure-inkling-dist.ts",
    "prepare": "pnpx husky",
    "pretest": "node scripts/ensure-inkling-dist.ts",
    "pretype": "node scripts/ensure-inkling-dist.ts",
    "release:bump": "node scripts/release.ts bump",
    "release:prepare-next": "node scripts/release.ts prepare-next",
    "release:tag": "node scripts/release.ts tag",
    "sea:build": "node scripts/sea/build.ts",
    "sea:e2e": "node scripts/sea/e2e.ts",
    "sea:smoke": "node scripts/sea/smoke.ts",
    "start": "node ./build/server/index.js",
    "test": "vitest run",
    "test:it": "vitest run --project it",
    "test:snaps": "vitest run --project snaps",
    "test:unit": "vitest run --project unit",
    "type": "react-router typegen && tsc",
    "zeabur:login": "pnpx zeabur@latest auth login",
    "zeabur:publish": "pnpx zeabur@latest template update -c TK7XLK -f zeabur-template.yml"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.3",
    "@napi-rs/canvas": "^1.0.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@base-ui/react": "^1.7.0",
    "@bufbuild/protobuf": "^2.14.1",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@inkling/editor": "workspace:*",
    "@maxmind/geoip2-node": "^7.1.0",
    "@number-flow/react": "^0.6.2",
    "@orpc/client": "^1.15.0",
    "@orpc/react-query": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@react-router/dev": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@shikijs/transformers": "^4.4.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "@smithy/types": "^4.18.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/diff-match-patch": "^1.0.36",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.14",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "fake-indexeddb": "^6.2.5",
    "feed": "^6.0.0",
    "happy-dom": "^20.14.0",
    "hono": "^4.13.5",
    "hono-pino": "^0.10.3",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "jsdom": "^30.0.1",
    "katex": "^0.18.5",
    "lint-staged": "^17.4.1",
    "lucide-react": "^1.40.0",
    "lunar-typescript": "^1.8.6",
    "medium-zoom": "^1.1.0",
    "motion": "^13.2.0",
    "nodemailer": "^9.1.1",
    "oxc-transform-react": "^0.148.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino": "^10.3.1",
    "pinyin-pro": "^3.29.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "taze": "^21.1.0",
    "typescript": "7.0.2",
    "ua-parser-js": "^2.0.10",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  },
  "lint-staged": {
    "{src,tests,scripts}/**/*.{ts,tsx}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ],
    "{drizzle.config.ts,oxfmt.config.ts,oxlint.config.ts,react-router.config.ts,taze.config.ts,vite.config.ts,vite.sea.config.ts,vitest.config.ts}": [
      "oxfmt -c oxfmt.config.ts --write --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26.8.1"
  },
  "packageManager": "pnpm@12.3.4"
}
