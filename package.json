{
  "name": "kobato",
  "version": "6.1.0",
  "private": true,
  "description": "A self-hosted blog CMS built with React Router 7, Hono, and oRPC",
  "keywords": [
    "blog",
    "cms",
    "kobato",
    "こばと"
  ],
  "homepage": "https://github.com/syhily/kobato",
  "bugs": {
    "url": "https://github.com/syhily/kobato/issues",
    "email": "syhily@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Yufan Sheng",
    "email": "syhily@gmail.com",
    "url": "https://github.com/syhily"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syhily/kobato"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:generate": "drizzle-kit generate",
    "dev": "react-router dev",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.yml down",
    "docker:test": "docker compose -f docker/docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker/docker-compose.test.yml down",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "lint": "oxlint -c oxlint.config.ts",
    "prepare": "npx husky",
    "preview": "node ./build/server/index.js",
    "start": "node ./build/server/index.js",
    "test": "vitest run",
    "test:it": "vitest run --project it",
    "test:snaps": "vitest run --project snaps",
    "test:unit": "vitest run --project unit",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@base-ui/react": "^1.5.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.0.4",
    "@maxmind/geoip2-node": "^6.3.4",
    "@meting/core": "^1.6.1",
    "@napi-rs/canvas": "^1.0.0",
    "@orpc/client": "^1.14.4",
    "@orpc/react-query": "^1.14.4",
    "@orpc/server": "^1.14.4",
    "@portabletext/react": "^6.2.0",
    "@portabletext/to-html": "^5.0.2",
    "@react-router/node": "^7.16.0",
    "@shikijs/transformers": "^4.1.0",
    "@tanstack/react-query": "^5.100.14",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-focus": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
