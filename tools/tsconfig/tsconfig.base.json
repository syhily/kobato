{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2024.Object"],
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "paths": {
      "@/*": ["../../apps/kobato/src/*"],
      "@tests/*": ["../../apps/kobato/tests/*"],
      "@kobato/inkling-demo/*": ["../../apps/inkling-demo/src/*"],
      "@kobato/inkling": ["../../packages/inkling/src/index.ts"],
      "@kobato/inkling/headless": ["../../packages/inkling/src/headless/index.ts"],
      "@kobato/inkling/headless/*": ["../../packages/inkling/src/headless/*"],
      "@kobato/inkling/host-cards": ["../../packages/inkling/src/host-cards/index.ts"],
      "@kobato/inkling/styles/*": ["../../packages/inkling/src/styles/*"],
      "@kobato/inkling/assets/*": ["../../packages/inkling/src/assets/*"],
      "@kobato/inkling-internal/*": ["../../packages/inkling/src/*"],
      "@kobato/inkling/tests/*": ["../../packages/inkling/tests/*"],
      "@kobato/api/*": ["../../packages/api/src/*"],
      "@kobato/api/tests/*": ["../../packages/api/tests/*"],
      "@kobato/db/*": ["../../packages/db/src/*"],
      "@kobato/db/tests/*": ["../../packages/db/tests/*"],
      "@kobato/server/*": ["../../packages/server/src/*"],
      "@kobato/server/tests/*": ["../../packages/server/tests/*"],
      "@kobato/ui/*": ["../../packages/ui/src/*"],
      "@kobato/ui/tests/*": ["../../packages/ui/tests/*"],
      "@kobato/web-admin/*": ["../../packages/web/admin/src/*"],
      "@kobato/web-admin/tests/*": ["../../packages/web/admin/tests/*"],
      "@kobato/web-client/*": ["../../packages/web/client/src/*"],
      "@kobato/web-client/tests/*": ["../../packages/web/client/tests/*"],
      "@kobato/web-public/*": ["../../packages/web/public/src/*"],
      "@kobato/web-public/tests/*": ["../../packages/web/public/tests/*"],
      "@kobato/utils/*": ["../../packages/shared/utils/src/*"],
      "@kobato/utils/tests/*": ["../../packages/shared/utils/tests/*"],
      "@kobato/i18n/*": ["../../packages/shared/i18n/src/*"],
      "@kobato/i18n/tests/*": ["../../packages/shared/i18n/tests/*"],
      "@kobato/cache/*": ["../../packages/shared/cache/src/*"],
      "@kobato/cache/tests/*": ["../../packages/shared/cache/tests/*"],
      "@kobato/auth/*": ["../../packages/shared/auth/src/*"],
      "@kobato/auth/tests/*": ["../../packages/shared/auth/tests/*"],
      "@kobato/catalog/*": ["../../packages/shared/catalog/src/*"],
      "@kobato/catalog/tests/*": ["../../packages/shared/catalog/tests/*"],
      "@kobato/distribution/*": ["../../packages/shared/distribution/src/*"],
      "@kobato/distribution/tests/*": ["../../packages/shared/distribution/tests/*"],
      "@kobato/settings/*": ["../../packages/shared/settings/src/*"],
      "@kobato/settings/tests/*": ["../../packages/shared/settings/tests/*"],
      "@kobato/assets/*": ["../../packages/shared/assets/src/*"],
      "@kobato/assets/tests/*": ["../../packages/shared/assets/tests/*"],
      "@kobato/sanitize/*": ["../../packages/shared/sanitize/src/*"],
      "@kobato/sanitize/tests/*": ["../../packages/shared/sanitize/tests/*"],
      "@kobato/test/*": ["../../tools/test/src/*"],
      "@kobato/font-split": ["../../tools/font-split/src/index.ts"],
      "@kobato/font-split/*": ["../../tools/font-split/src/*"],
      "@kobato/pack/*": ["../../tools/pack/src/*"],
      "@kobato/trace/*": ["../../tools/trace/src/*"],
      "@kobato/trace/tests/*": ["../../tools/trace/tests/*"]
    }
  }
}
