{
  "name": "@kobato/pack",
  "version": "8.2.2-dev",
  "private": true,
  "type": "module",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "release:bump": "node src/release.ts bump",
    "release:prepare-next": "node src/release.ts prepare-next",
    "release:since-last": "node src/release.ts since-last",
    "release:tag": "node src/release.ts tag",
    "sea:browser": "node src/sea/browser.ts --managed",
    "sea:build": "node src/sea/build.ts",
    "sea:e2e": "node src/sea/e2e.ts",
    "sea:package": "node src/sea/package.ts",
    "sea:probe": "node src/sea/vfs-capabilities.ts",
    "sea:smoke": "node src/sea/smoke.ts",
    "test:browser": "node src/sea/browser.ts",
    "version:sync": "node src/release.ts sync-versions"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "catalog:",
    "@kobato/base": "workspace:*",
    "@kobato/instance": "workspace:*",
    "@kobato/server": "workspace:*",
    "@kobato/test": "workspace:*",
    "@kobato/tsconfig": "workspace:*",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "oxc-transform-react": "catalog:",
    "sharp": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
