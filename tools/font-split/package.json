{
  "name": "@kobato/font-split",
  "version": "8.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": [
      "./src/index.ts"
    ],
    "./font-split.node": "./font-split.node",
    "./binding": "./src/binding.d.ts",
    "./package.json": "./package.json",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "build": "napi build --release --output-dir . --dts src/binding.d.ts",
    "corpus:build": "cargo run --release --features corpus --bin corpus -- build",
    "corpus:download": "cargo run --release --features corpus --bin corpus -- download",
    "corpus:generate": "cargo run --release --features corpus --bin corpus -- generate",
    "corpus:test": "cargo test --features corpus --test corpus",
    "corpus:update": "pnpm run corpus:generate && cargo test --features corpus && pnpm run build",
    "fixture:blog": "cargo run --release --features corpus --bin corpus -- blog-pages",
    "lint": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "pagecost:report": "cargo test --release --test page_cost page_cost_font_report -- --ignored --nocapture",
    "pagecost:sweep": "cargo test --release --features bench --test page_cost page_cost_lambda_sweep -- --ignored --nocapture",
    "test": "cargo test"
  },
  "devDependencies": {
    "@kobato/tsconfig": "workspace:*",
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:"
  },
  "napi": {
    "binaryName": "font-split",
    "dtsHeader": "/* oxlint-disable no-duplicate-type-constituents */\n/* oxfmt-ignore */"
  }
}
