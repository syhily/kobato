{
  "name": "@kobato/font-split",
  "version": "8.2.1-dev",
  "private": true,
  "type": "module",
  "exports": {
    ".": [
      "./src/index.ts"
    ],
    "./font-split.node": "./font-split.node",
    "./package.json": "./package.json",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "build": "cargo build --release && node scripts/copy-addon.ts",
    "cjk-tables:generate": "cargo run --release --features corpus --bin datagen -- generate",
    "cjk-tables:update": "pnpm run cjk-tables:generate && cargo test --features corpus && pnpm run build",
    "corpus:build": "cargo run --release --features corpus --bin datagen -- build",
    "corpus:download": "cargo run --release --features corpus --bin datagen -- download",
    "corpus:test": "cargo test --features corpus --test datagen",
    "test": "cargo test"
  }
}
