{
  "name": "@kobato/font-split",
  "version": "8.2.2-dev",
  "private": true,
  "type": "module",
  "exports": {
    ".": [
      "./src/index.ts"
    ],
    "./font-split.node": "./font-split.node",
    "./binding": "./src/binding.d.ts",
    "./package.json": "./package.json",
    "./scripts/*": [
      "./scripts/*.ts"
    ],
    "./tests/*": "./tests/*",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "bench:font-split": "node scripts/bench.ts",
    "build": "napi build --release --output-dir . --dts src/binding.d.ts",
    "cjk-tables:generate": "node scripts/gen-cjk-tables.ts",
    "cjk-tables:update": "pnpm run cjk-tables:generate && pnpm run test && pnpm run build",
    "corpus:build": "node scripts/corpus.ts build",
    "corpus:download": "node scripts/corpus.ts download",
    "corpus:generate": "node scripts/corpus.ts generate",
    "corpus:update": "pnpm run corpus:generate && pnpm run test && pnpm run build",
    "fixture:blog": "node scripts/corpus.ts blog-pages",
    "lint": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "pagecost:report": "cargo test --release --test page_cost page_cost_font_report -- --ignored --nocapture",
    "pagecost:sweep": "cargo test --release --features bench --test page_cost page_cost_lambda_sweep -- --ignored --nocapture",
    "scripts:test": "pnpm -C ../.. exec vitest run tools/font-split/tests/unit",
    "test": "cargo test"
  },
  "devDependencies": {
    "@kobato/base": "workspace:*",
    "@kobato/test": "workspace:*",
    "@kobato/tsconfig": "workspace:*",
    "@napi-rs/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "opencc-js": "catalog:",
    "sharp": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "napi": {
    "binaryName": "font-split",
    "dtsHeader": "/* oxlint-disable no-duplicate-type-constituents */\n/* oxfmt-ignore */"
  }
}
