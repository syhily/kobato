{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "include": [
    "env.d.ts",
    "packages/**/*",
    "packages/test-utils/tests/**/*",
    "vitest/**/*",
    "scripts/**/*",
    "examples/**/*",
    "drizzle.config.ts",
    "apps/core/vite.config.ts",
    "apps/public/vite.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "vite.sea.config.ts",
    "**/.server/**/*",
    "**/.client/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Stage 1 (test migration) retired the temporary bridge that let
    // root-level tests import app sources: no root-program file imports
    // `@/…` anymore (app tests live in `apps/*/tests`, type-checked by
    // each app's own tsconfig — which includes its `tests/**/*` and maps
    // `@/*` to its own src — and executed at runtime by the vitest
    // projects), so the `@/*` path mapping, the app rootDirs entries and
    // the `react-router-register.d.ts` placeholder are gone. The apps
    // are checked by their own tsconfigs (apps/core|public/tsconfig.json);
    // `@kobato/*` + `#/*` serve the packages and the repository-level
    // tests.
    "paths": {
      "#/*": ["./packages/test-utils/tests/*"],
      "@kobato/shared/*": ["./packages/shared/src/*"],
      "@kobato/client/*": ["./packages/client/src/*"],
      "@kobato/server/*": ["./packages/server/src/*"],
      "@kobato/ui/*": ["./packages/ui/src/*"],
      "@kobato/editor/*": ["./packages/editor/src/*"],
      "@kobato/sdk/*": ["./packages/sdk/src/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true
  },
  "exclude": ["build", "dist", "dist-sea", "apps/**/.react-router"]
}
