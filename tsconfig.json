{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@kobato/toolchain/tsconfig.base.json",
  "include": [
    "apps/kobato/**/*",
    "packages/**/*",
    "tools/**/*",
    "scripts/**/*",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "vite.sea.config.ts",
    "vitest.config.ts",
    "apps/kobato/.react-router/types/**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    // Ambient ImportMetaEnv/CSSProperties augmentations for the demo sources
    // that packages/inkling tests import — the file itself is imported by
    // nobody, so it must be named here (the rest of apps/inkling-demo/ stays
    // out of the program).
    "apps/inkling-demo/src/types/vite-env.d.ts"
  ],
  "compilerOptions": {
    "rootDirs": [".", "./apps/kobato", "./apps/kobato/.react-router/types"]
  },
  "exclude": ["build", "dist", "node_modules", "apps/kobato/build"]
}
