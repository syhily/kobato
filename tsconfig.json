{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "include": [
    "apps/**/*",
    "packages/**/*",
    "scripts/**/*",
    "drizzle.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "vite.sea.config.ts",
    "vitest.config.ts",
    "apps/kobato/.react-router/types/**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    // Ambient ImportMetaEnv/CSSProperties augmentations for the demo sources
    // that packages/inkling tests import — the file itself is imported by
    // nobody, so it must be named here (the rest of demo/ stays out of the
    // program).
    "demo/types/vite-env.d.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2024.Object"],
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./apps/kobato", "./apps/kobato/.react-router/types"],
    "paths": {
      "@/*": ["./apps/kobato/src/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true
  },
  "exclude": ["build", "dist", "node_modules", "apps/kobato/build"]
}
