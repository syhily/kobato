{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "drizzle.config.ts",
    "react-router.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "vite.sea.config.ts",
    "vite.config.ts",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2024.Object"],
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./tests/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true
  },
  "exclude": ["build", "dist"]
}
