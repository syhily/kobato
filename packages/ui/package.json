{
  "name": "@kobato/ui",
  "version": "8.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./components/*": [
      "./src/components/*.ts",
      "./src/components/*.tsx"
    ],
    "./icons/*": [
      "./src/icons/*.ts",
      "./src/icons/*.tsx"
    ],
    "./lib/*": [
      "./src/lib/*.ts",
      "./src/lib/*.tsx"
    ],
    "./styles/base-defaults.css": "./src/styles/base-defaults.css",
    "./styles/dark-variant.css": "./src/styles/dark-variant.css",
    "./styles/tailwind.css": "./src/styles/tailwind.css",
    "./styles/typeset.css": "./src/styles/typeset.css",
    "./styles/ui.css": "./src/styles/ui.css",
    "./tests/*": "./tests/*"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@kobato/i18n": "workspace:*",
    "@kobato/settings": "workspace:*",
    "@kobato/test": "workspace:*",
    "@kobato/utils": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cn": "catalog:",
    "happy-dom": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "pino": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-intl": "catalog:",
    "react-router": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "vitest": "catalog:"
  }
}
