{
  "name": "@inkling/editor",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Yufan Sheng",
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/editor.umd.cjs",
  "module": "./dist/editor.js",
  "types": "./dist/editor.d.ts",
  "imports": {
    "#/*": "./test/*"
  },
  "exports": {
    ".": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.umd.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./style.css": "./dist/style.css",
    "./core.css": "./dist/core.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && INKLING_ENTRY=core vite build && node scripts/copy-legacy-umd.ts && node scripts/build-types.ts",
    "build-storybook": "storybook build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "bump": "taze && pnpm update",
    "coverage": "vitest run --coverage",
    "dev": "concurrently \"vite --host --force\" \"pnpm build --watch\" \"pnpm preview -l silent --host\"",
    "dev:multiplayer": "concurrently \"vite\" \"pnpm multiplayer\"",
    "dev:test": "concurrently \"VITE_TEST=true vite --port 5174\" \"pnpm multiplayer\"",
    "fix": "pnpm store prune && rm -rf node_modules && pnpm install",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && node scripts/check-test-skips.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --fix .",
    "main": "git checkout main && git pull ${INKLING_UPSTREAM:-origin} main && pnpm install",
    "multiplayer": "HOST=localhost PORT=1234 npx y-websocket-server",
    "precoverage": "pnpm build",
    "prepare": "husky .github/hooks",
    "presetup": "pnpm install",
    "pretest": "VITE_TEST=true pnpm build --config vite.config.demo.ts && pnpm build",
    "pretest:unit": "pnpm build",
    "pretest:watch": "pnpm pretest",
    "preview": "vite preview --outDir dist-demo",
    "setup": "pnpm install && pnpm build",
    "storybook": "NODE_OPTIONS=--openssl-legacy-provider storybook dev -p 6006 -h 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS='--experimental-specifier-resolution=node --no-warnings' VITE_TEST=true playwright test",
    "test:e2e:headed": "PLAYWRIGHT_HEADED=true pnpm test:e2e",
    "test:e2e:quiet": "pnpm test:e2e --reporter=line",
    "test:e2e:report": "PLAYWRIGHT_HTML_REPORT=true pnpm test:e2e",
    "test:slowmo": "TIMEOUT=100000 PLAYWRIGHT_SLOWMO=100 pnpm test:e2e:headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:unit && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:source": "tsc --noEmit",
    "typecheck:unit": "tsc --noEmit -p tsconfig.unit.json",
    "verify:package": "node scripts/verify-packed-package.ts",
    "verify:sizes": "node scripts/verify-entry-sizes.ts",
    "verify:types": "node scripts/verify-packed-types.ts"
  },
  "dependencies": {
    "@lexical/table": "0.46.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.4",
    "@emoji-mart/data": "1.2.1",
    "@etchteam/storybook-addon-status": "8.1.0",
    "@lexical/clipboard": "0.46.0",
    "@lexical/headless": "0.46.0",
    "@lexical/html": "0.46.0",
    "@lexical/link": "0.46.0",
    "@lexical/list": "0.46.0",
    "@lexical/markdown": "0.46.0",
    "@lexical/react": "0.46.0",
    "@lexical/rich-text": "0.46.0",
    "@lexical/selection": "0.46.0",
    "@lexical/text": "0.46.0",
    "@lexical/utils": "0.46.0",
    "@lezer/highlight": "1.2.3",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.61.1",
    "@prettier/sync": "0.6.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@storybook/addon-links": "10.4.6",
    "@storybook/react": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/html-minifier-terser": "7.0.2",
    "@types/jsdom": "28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/trusted-types": "2.0.7",
    "@uiw/codemirror-extensions-basic-setup": "4.25.10",
    "@uiw/react-codemirror": "4.25.10",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "concurrently": "10.0.3",
    "dompurify": "3.4.11",
    "emoji-mart": "5.6.0",
    "fast-average-color": "9.5.2",
    "html-minifier-terser": "7.2.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lexical": "0.46.0",
    "lint-staged": "17.0.8",
    "markdown-it": "14.3.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-lazy-headers": "0.1.3",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.9.4",
    "prettier-plugin-organize-attributes": "1.0.0",
    "react": "19.2.7",
    "react-colorful": "5.7.0",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "rolldown": "1.2.0",
    "rolldown-plugin-dts": "0.27.14",
    "secretlint": "13.0.2",
    "storybook": "10.4.6",
    "stylelint": "17.14.0",
    "tailwindcss": "4.3.2",
    "taze": "^20.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.9",
    "y-websocket": "3.0.0",
    "yjs": "13.6.31"
  },
  "peerDependencies": {
    "jsdom": ">=24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.18.0"
}
