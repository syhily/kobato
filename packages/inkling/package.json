{
  "name": "@inkling/editor",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Yufan Sheng",
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/editor.umd.cjs",
  "module": "./dist/editor.js",
  "types": "./dist/editor.d.ts",
  "imports": {
    "#/*": "./test/*"
  },
  "exports": {
    ".": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.umd.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./style.css": "./dist/style.css",
    "./core.css": "./dist/core.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && INKLING_ENTRY=core vite build && INKLING_ENTRY=headless vite build && node scripts/copy-legacy-umd.ts && node scripts/build-types.ts",
    "build:watch": "vite build --watch",
    "coverage": "vitest run --coverage",
    "format": "pnpm -C ../.. exec oxfmt -c oxfmt.config.ts --write packages/inkling",
    "format:check": "pnpm -C ../.. exec oxfmt -c oxfmt.config.ts --check packages/inkling",
    "lint": "pnpm -C ../.. exec oxlint -c oxlint.config.ts packages/inkling && node scripts/check-test-skips.ts",
    "lint:fix": "pnpm -C ../.. exec oxlint -c oxlint.config.ts --fix packages/inkling",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:unit",
    "typecheck:source": "tsc --noEmit",
    "typecheck:unit": "tsc --noEmit -p tsconfig.unit.json",
    "verify:package": "node scripts/verify-packed-package.ts",
    "verify:sizes": "node scripts/verify-entry-sizes.ts",
    "verify:types": "node scripts/verify-packed-types.ts"
  },
  "dependencies": {
    "@lexical/table": "catalog:"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/view": "catalog:",
    "@emoji-mart/data": "catalog:",
    "@lexical/clipboard": "catalog:",
    "@lexical/headless": "catalog:",
    "@lexical/html": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/list": "catalog:",
    "@lexical/markdown": "catalog:",
    "@lexical/react": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/selection": "catalog:",
    "@lexical/text": "catalog:",
    "@lexical/utils": "catalog:",
    "@lezer/highlight": "catalog:",
    "@mdx-js/rollup": "catalog:",
    "@prettier/sync": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/html-minifier-terser": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/trusted-types": "catalog:",
    "@uiw/codemirror-extensions-basic-setup": "catalog:",
    "@uiw/react-codemirror": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dompurify": "catalog:",
    "emoji-mart": "catalog:",
    "fast-average-color": "catalog:",
    "html-minifier-terser": "catalog:",
    "jsdom": "catalog:",
    "lexical": "catalog:",
    "markdown-it": "catalog:",
    "markdown-it-footnote": "catalog:",
    "markdown-it-lazy-headers": "catalog:",
    "markdown-it-mark": "catalog:",
    "markdown-it-sub": "catalog:",
    "markdown-it-sup": "catalog:",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-attributes": "catalog:",
    "react": "catalog:",
    "react-colorful": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "vitest": "catalog:",
    "y-websocket": "catalog:",
    "yjs": "catalog:"
  },
  "peerDependencies": {
    "jsdom": ">=24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  }
}
