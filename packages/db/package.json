{
  "name": "@kobato/db",
  "version": "8.2.0",
  "private": true,
  "files": [
    "src",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./database": "./src/database.ts",
    "./errors": "./src/errors.ts",
    "./like-escape": "./src/like-escape.ts",
    "./migrate": "./src/migrate.ts",
    "./target": "./src/target.ts",
    "./types": "./src/types.ts",
    "./duckdb/*": [
      "./src/duckdb/*.ts",
      "./src/duckdb/*.tsx"
    ],
    "./operations/*": [
      "./src/operations/*.ts",
      "./src/operations/*.tsx"
    ],
    "./schema/*": [
      "./src/schema/*.ts",
      "./src/schema/*.tsx"
    ],
    "./drizzle/*": "./drizzle/*"
  },
  "scripts": {
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@duckdb/node-api": "catalog:",
    "@kobato/inkling": "workspace:*",
    "@kobato/settings": "workspace:*",
    "@kobato/test": "workspace:*",
    "@kobato/utils": "workspace:*",
    "@types/node": "catalog:",
    "bcryptjs": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "kysely": "catalog:",
    "vitest": "catalog:"
  }
}
