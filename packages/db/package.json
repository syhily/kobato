{
  "name": "@kobato/db",
  "version": "8.2.1-dev",
  "private": true,
  "files": [
    "src",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./sqlite/*": [
      "./src/sqlite/*.ts",
      "./src/sqlite/*.tsx"
    ],
    "./sqlite/operations/*": [
      "./src/sqlite/operations/*.ts",
      "./src/sqlite/operations/*.tsx"
    ],
    "./sqlite/schema/*": [
      "./src/sqlite/schema/*.ts",
      "./src/sqlite/schema/*.tsx"
    ],
    "./duckdb/*": [
      "./src/duckdb/*.ts",
      "./src/duckdb/*.tsx"
    ],
    "./drizzle/*": "./drizzle/*"
  },
  "scripts": {
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@duckdb/node-api": "catalog:",
    "@duckdbfan/drizzle-duckdb": "catalog:",
    "@kobato/inkling": "workspace:*",
    "@kobato/settings": "workspace:*",
    "@kobato/test": "workspace:*",
    "@kobato/utils": "workspace:*",
    "@types/node": "catalog:",
    "bcryptjs": "catalog:",
    "drizzle-kit": "1.0.0-rc.6",
    "drizzle-orm": "1.0.0-rc.6",
    "vitest": "catalog:"
  }
}
