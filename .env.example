# Kobato 的环境变量只作覆盖用途——默认配置来源是配置文件
# `kobato.config.json`(首次启动自动创建;见 kobato.config.example.json)。
#
# 环境变量名 = 配置路径用双下划线连接(Ghost 约定),例如:
#   database.url           → database__url
#   auth.sessionSecret     → auth__sessionSecret
#
# 优先级:schema 默认值 < 配置文件 < 环境变量。
# 注意:来自环境变量的覆盖会【写回配置文件】并持久化——env 是注入手段,
# 文件是生效配置的持久记录。如果你复制本文件为 .env 使用,这些值会在
# 下次启动时被合并进 kobato.config.json。
#
# ─── Server ─────────────────────────────────────────────────────────────────

# Node environment: development, production, or test.
# Defaults to "production" when unset. Set to "development" for local dev.
# (进程级开关,不进入配置文件)
NODE_ENV=development

# The listen address for the HTTP server.
# Use "0.0.0.0" to bind all interfaces (required inside Docker / CI).
# Default: 0.0.0.0
server__host=0.0.0.0

# The listen port for the HTTP server.
# Must be between 1 and 65535. Default: 4321
server__port=4321

# ─── Session ────────────────────────────────────────────────────────────────

# Secret used to sign session cookies (HMAC).
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
#
# Supports comma-separated rotation secrets for zero-downtime key rotation:
#   auth__sessionSecret=new-secret,old-secret
# The FIRST secret is used for signing; ALL secrets are tried for verification.
auth__sessionSecret=

# ─── Secret Encryption ──────────────────────────────────────────────────────

# AES-256-GCM key used to encrypt sensitive settings before they touch
# Postgres JSONB (mail apiKey, S3 secretAccessKey, search apiKey).
# Generate one with: openssl rand -hex 32
security__encryptionKey=

# ─── Database ───────────────────────────────────────────────────────────────

# PostgreSQL connection URL.
# Example: postgres://user:password@localhost:5432/kobato
database__url=

# Redis connection URL.
# Used for session storage, rate limiting, cache buckets, and the
# settings snapshot version counter.
# Example: redis://localhost:6379
redis__url=

# Optional prefix added to every Redis key by ioredis.
# Primarily used in test environments to isolate parallel workers.
redis__keyPrefix=

# Maximum number of connections in the Postgres connection pool.
# Default: 20
database__poolMax=20

# Per-query statement timeout in milliseconds.
# Default: 30000 (30 seconds)
database__statementTimeoutMs=30000

# Optional dedicated low-privilege Postgres role used during restore.
database__restoreRole=

# ─── Logging ────────────────────────────────────────────────────────────────

# Minimum log level. One of: debug, info, warn, error, silent.
logging__level=

# ─── Data directory ─────────────────────────────────────────────────────────

# Root directory for all local filesystem data. Fonts, analytics / audit
# dead-letter files, and the MaxMind GeoLite2-City database live in fixed
# subdirectories under this path.
paths__data=./data

# Optional fallback font path copied into <data>/fonts when empty.
paths__defaultFont=

# ─── SEA binary ─────────────────────────────────────────────────────────────

# Cache directory used only by the SEA single-executable build: on first
# run it extracts the embedded native packages (sharp, canvas) there.
# Defaults to $XDG_CACHE_HOME/kobato, or ~/.cache/kobato when
# XDG_CACHE_HOME is unset. Irrelevant for `node ./build/server/index.js`.
# (SEA prelude 级变量,不进入配置文件)
# KOBATO_CACHE_DIR=
