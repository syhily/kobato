# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# Server
HOST=0.0.0.0
PORT=4321

# Session cookie signing
SESSION_SECRET=

# Database
DATABASE_URL=
REDIS_URL=

# Extra database configuration (optional)
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000

# Log setting (optional)
LOG_LEVEL=

# Analytics (optional)
# Filesystem path to the MaxMind GeoLite2-City mmdb. When unset, the
# analytics ingestion pipeline still records visits but the geo
# columns (country / region / city / lat / lon / timezone) are NULL.
# Download from https://www.maxmind.com/en/geolite2/signup and drop
# the binary at the path below (gitignored by default).
MAXMIND_DB_PATH=./data/maxmind/GeoLite2-City.mmdb

# When `true`, admin sessions' visits to the home / detail pages are
# written to `access_log` like any other visitor. Default `false` keeps
# the dashboard owner out of their own visitor metrics. Flip on locally
# while debugging the analytics dashboard.
ANALYTICS_TRACK_ADMIN=false

# When `true`, bot rows are kept in `access_log`. Default `false` strips
# them. The continuous aggregates already filter on `is_bot = FALSE` so
# leaving bot rows in is mainly a forensic / debugging affordance.
ANALYTICS_KEEP_BOT_ROWS=false
