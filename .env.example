# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# ─── Server ─────────────────────────────────────────────────────────────────

# Node environment: development, production, or test.
# Defaults to "production" when unset. Set to "development" for local dev.
NODE_ENV=development

# The listen address for the HTTP server.
# Use "0.0.0.0" to bind all interfaces (required inside Docker / CI).
# Default: 0.0.0.0
HOST=0.0.0.0

# The listen port for the HTTP server.
# Must be between 1 and 65535. Default: 4321
PORT=4321

# ─── Session ────────────────────────────────────────────────────────────────

# Secret used to sign session cookies (HMAC).
# Must be non-empty. Any random string of sufficient length works.
# Generate one with: openssl rand -hex 32
#
# Supports comma-separated rotation secrets for zero-downtime key rotation:
#   SESSION_SECRET=new-secret,old-secret
# The FIRST secret is used for signing; ALL secrets are tried for verification.
# Commas are separators — do not include them in individual secret values.
SESSION_SECRET=

# ─── Secret Encryption ──────────────────────────────────────────────────────

# AES-256-GCM key used to encrypt sensitive settings before they touch
# Postgres JSONB. The three secret fields below are encrypted at the
# application layer before every DB write and decrypted on read:
#
#   - blog.mail → mail.apiKey
#   - blog.assets → storage.secretAccessKey
#   - blog.search → search.apiKey
#
# Any arbitrary string works; it is hashed to a 32-byte key with SHA-256.
# Generate one with: openssl rand -hex 32
#
# Migration from plaintext:
#   1. Set ENCRYPTION_KEY in .env and restart.
#   2. Plaintext secrets are encrypted automatically on startup.
#   3. Already-encrypted secrets are verified against the key.
ENCRYPTION_KEY=

# ─── Database ───────────────────────────────────────────────────────────────

# PostgreSQL connection URL.
# Example: postgres://user:password@localhost:5432/kobato
DATABASE_URL=

# Redis connection URL.
# Used for session storage, rate limiting, cache buckets, and the
# settings snapshot version counter.
# Example: redis://localhost:6379
REDIS_URL=

# Optional prefix added to every Redis key by ioredis.
# Primarily used in test environments to isolate parallel workers.
# Leave unset in production unless you share a Redis instance with
# other applications and need key namespacing.
REDIS_KEY_PREFIX=

# Maximum number of connections in the Postgres connection pool.
# Each server process maintains its own pool via `pg.Pool`.
# Default: 20
DB_POOL_MAX=20

# Per-query statement timeout in milliseconds.
# Any query that takes longer than this is cancelled by Postgres.
# Applies to all queries through the Drizzle ORM connection.
# Default: 30000 (30 seconds)
DB_STATEMENT_TIMEOUT_MS=30000

# Optional dedicated low-privilege Postgres role used during restore.
# When set, psql runs with --role=<role> --no-owner and issues SET ROLE
# before applying the dump, limiting the blast radius of a validator bypass.
# The configured DATABASE_URL user must be able to switch to this role.
# RESTORE_ROLE=

# ─── Logging ────────────────────────────────────────────────────────────────

# Minimum log level. One of: debug, info, warn, error.
# When unset, the logger defaults to "info".
LOG_LEVEL=

# ─── Data directory ─────────────────────────────────────────────────────────

# Root directory for all local filesystem data. Fonts, analytics / audit
# dead-letter files, and the MaxMind GeoLite2-City database live in fixed
# subdirectories under this path:
#   fonts/                      — TTF/OTF files uploaded through admin settings
#   analytics/dead-letter.jsonl — dead-letter file for analytics batcher
#   audit/dead-letter.jsonl     — dead-letter file for audit batcher
#   maxmind/GeoLite2-City.mmdb — uploaded through admin settings
DATA_PATH=./data

# Canvas fallback font path. The Docker image ships with font-noto-cjk and
# sets this automatically. Only override if you want a different system font.
# DEFAULT_FONT_PATH=/usr/share/fonts/noto/NotoSansCJK-Regular.ttc
