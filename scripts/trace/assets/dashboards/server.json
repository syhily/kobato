        {
          "id": "sv-ssr",
          "type": "line",
          "title": "SSR shell and stream",
          "description": "rr/ssr span duration by operation",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS x, operation_name, avg(duration) AS avg_us FROM \"default\" WHERE service_name = 'kobato' AND operation_name IN ('rr.document', 'rr.data', 'ssr.shell', 'ssr.stream') GROUP BY x, operation_name ORDER BY x",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "x",
                    "alias": "x",
                    "column": "x",
                    "type": "build"
                  }
                ],
                "y": [
                  {
                    "label": "y",
                    "alias": "y",
                    "column": "y",
                    "type": "build"
                  }
                ],
                "filter": {
                  "type": "condition",
                  "values": [],
                  "column": null,
                  "operator": "",
                  "value": null,
                  "logicalOperator": "AND",
                  "filterType": "condition"
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 5,
            "i": 1
