            }
          ],
          "layout": {
            "x": 0,
            "y": 4,
            "w": 12,
            "h": 4,
            "i": 2
          }
        },
        {
          "id": "co-db",
          "type": "table",
          "title": "DB and SSR spans by trace",
          "description": "trace_ids shared with the RUM resource panel",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT trace_id, operation_name, db_engine, db_operation, duration FROM \"default\" WHERE service_name = 'kobato' AND (operation_name IN ('db.sqlite.query', 'db.duckdb.query', 'ssr.shell', 'ssr.stream')) ORDER BY start_time DESC LIMIT 200",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
