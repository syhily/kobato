        },
        {
          "id": "co-logs",
          "type": "table",
          "title": "Server log lines",
          "description": "privacy-projected log lines for the same traces; join on trace_id/span_id (O2 cannot join logs to traces in one query)",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT trace_id, span_id, body, severity, log_scope, http_request_method, http_response_status_code, _timestamp FROM \"kobato_logs\" WHERE service_name = 'kobato' ORDER BY _timestamp DESC LIMIT 300",
