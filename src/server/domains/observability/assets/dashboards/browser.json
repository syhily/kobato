{
  "version": 8,
  "title": "Kobato — Browser",
  "description": "Hard/soft navigation, Web Vitals, long tasks, resources and sanitized errors.",
  "tabs": [
    {
      "tabId": "default",
      "name": "Overview",
      "panels": [
        {
          "id": "br-views",
          "type": "table",
          "title": "Views by route",
          "description": "hard and SPA navigations grouped by route template",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT view_name, view_loading_type, count(*) AS views, avg(view_loading_time) / 1000.0 AS avg_loading_us FROM \"_rumdata\" WHERE type = 'view' GROUP BY view_name, view_loading_type ORDER BY views DESC",
              "customQuery": true,
              "fields": {
                "stream": "_rumdata",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "x",
                    "alias": "x",
                    "column": "x",
                    "type": "build"
                  }
                ],
                "y": [
                  {
                    "label": "y",
                    "alias": "y",
                    "column": "y",
                    "type": "build"
                  }
                ],
                "filter": {
                  "type": "condition",
                  "values": [],
                  "column": null,
                  "operator": "",
                  "value": null,
                  "logicalOperator": "AND",
                  "filterType": "condition"
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 4,
            "i": 1
          }
        },
