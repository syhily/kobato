          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT view_name, count(*) AS views, avg(view_largest_contentful_paint) / 1000.0 AS lcp_us, avg(view_inp_us) AS inp_us, avg(view_cumulative_layout_shift) AS cls, avg(view_first_byte) / 1000.0 AS ttfb_us FROM \"_rumdata\" WHERE type = 'view' GROUP BY view_name ORDER BY views DESC",
              "customQuery": true,
              "fields": {
                "stream": "_rumdata",
                "stream_type": "logs",
                "x": [
