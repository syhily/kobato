          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS x, avg(view_largest_contentful_paint) / 1000.0 AS lcp_us, avg(view_inp_us) AS inp_us, avg(view_cumulative_layout_shift) AS cls FROM \"_rumdata\" WHERE type = 'view' GROUP BY x ORDER BY x",
