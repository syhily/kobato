        {
          "id": "ov-latency",
          "type": "table",
          "title": "Server latency by route (P50/P95/P99)",
          "description": "span duration is reported in microseconds",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT http_route, count(*) AS requests, approx_percentile_cont(duration, 0.5) AS p50_us, approx_percentile_cont(duration, 0.95) AS p95_us, approx_percentile_cont(duration, 0.99) AS p99_us FROM \"default\" WHERE service_name = 'kobato' AND operation_name = 'http.server' GROUP BY http_route ORDER BY p95_us DESC",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
