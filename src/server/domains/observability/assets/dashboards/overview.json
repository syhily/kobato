            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS x, count(*) AS y FROM \"default\" WHERE service_name = 'kobato' AND operation_name = 'http.server' AND span_status = 'ERROR' GROUP BY x ORDER BY x",
              "customQuery": true,
