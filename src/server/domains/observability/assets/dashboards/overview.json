        {
          "id": "ov-requests",
          "type": "line",
          "title": "HTTP requests per minute",
          "description": "server http.server spans by minute",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS x, count(*) AS y FROM \"default\" WHERE service_name = 'kobato' AND operation_name = 'http.server' GROUP BY x ORDER BY x",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "x",
                    "alias": "x",
                    "column": "x",
                    "type": "build"
                  }
                ],
                "y": [
                  {
                    "label": "y",
                    "alias": "y",
                    "column": "y",
                    "type": "build"
                  }
